# Copy this file to .env and adjust values for your environment.
# Never commit the real .env file.

# PostgreSQL connection string (SQLAlchemy format).
# Matches the docker-compose.yml service in this directory by default.
DATABASE_URL=postgresql+psycopg2://srm:srm_dev_password@localhost:5433/srm_db

# Local storage for uploaded imagery and mock processing outputs.
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# Comma-separated list of allowed frontend origins for CORS.
CORS_ORIGINS=http://localhost:5173

ENV=development

# --- Phase 5: Copernicus Data Space Ecosystem (Sentinel-2) -----------------
# OAuth2 client-credentials app registered at https://dataspace.copernicus.eu
# Leave blank to disable real satellite search — AOI-driven jobs will then
# fail with a clear "credentials not configured" error instead of silently
# mocking a scene. NEVER commit real values here.
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Public, non-secret endpoints — safe defaults, only override for a mirror.
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
COPERNICUS_CATALOG_URL=https://catalogue.dataspace.copernicus.eu/odata/v1
COPERNICUS_DOWNLOAD_URL=https://zipper.dataspace.copernicus.eu/odata/v1

# Local storage for downloaded satellite scene data.
SATELLITE_DIR=satellite
# Full Sentinel-2 SAFE products are typically 700MB-1GB; this caps what
# Phase 5 will actually pull to disk. See docs/ARCHITECTURE.md.
SATELLITE_MAX_DOWNLOAD_MB=200

# --- Phase 6.3: satellite provider selection --------------------------------
# 'copernicus' (default, above), 'gee' (Google Earth Engine, below), or
# 'fake' (test-only, no real data — same provider the test suite uses).
# Never silently falls back between providers. See
# app/services/satellite/service.py.
SATELLITE_PROVIDER=copernicus

# --- Phase 6.3: Google Earth Engine (alternative to Copernicus above) ------
# Backend-only Google Cloud service-account auth — never put these in the
# frontend. Leave blank to disable; SATELLITE_PROVIDER=gee then fails with a
# clear "credentials not configured" error rather than silently using
# another provider. Install with: pip install earthengine-api
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
# Path (relative to backend/, or absolute) to the service-account JSON key.
# NEVER commit the key file itself — see backend/.gitignore.
GEE_SERVICE_ACCOUNT_KEY_PATH=

# --- Phase 6: AI super-resolution -------------------------------------------
# 'mock' (default, safe — no PyTorch import, no checkpoint needed) or
# 'super_resolution' (real inference). Never silently falls back from
# super_resolution to mock if misconfigured — the job fails with a clear
# error instead. See backend/README.md "Phase 6" and docs/ARCHITECTURE.md §19.
PROCESSOR_MODE=mock

# Path (relative to backend/) to the trained checkpoint. Only read when
# PROCESSOR_MODE=super_resolution. Produce one with:
#   python -m ai.training.train --dataset sen2venus
SR_CHECKPOINT_PATH=ai/checkpoints/edsr_satellite.pt

# 'cpu', 'cuda', or leave blank to auto-detect (CUDA if available, else CPU).
SR_DEVICE=
